# ======================================================
# FormatFlow — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ======================================================

# ── App ───────────────────────────────────────────────
APP_NAME=FormatFlow
APP_VERSION=0.1.0
DEBUG=true

# ── CORS ──────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://formatflow:formatflow@localhost:5432/formatflow

# ── Cloudflare R2 ─────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=formatflow
R2_PUBLIC_URL=

# ── Security ──────────────────────────────────────────
SECRET_KEY=change-me-before-production

# ── Upload ────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ── Next.js ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
